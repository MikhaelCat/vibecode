# HTTP bind address and tracing filter.
BIND=0.0.0.0:8080
RUST_LOG=info,travel_ai=debug

# OpenRouter secret (leave empty to disable real LLM calls).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Comma-separated fallback model IDs, e.g. model-a,model-b.
OPENROUTER_FALLBACK_MODELS=
# T-Bank Spirit LLM Proxy (takes precedence over OpenRouter when token is set).
# For OpenRouter-routed models use the /v1 base, e.g. .../v1 + /chat/completions.
LLM_PROXY_TOKEN=
LLM_PROXY_URL=https://llm-proxy.spirit.t-education.com/v1
LLM_PROXY_MODEL=openrouter/deepseek/deepseek-v4.1-flash
DAILY_BUDGET_USD=25
# USD per 1M tokens; 0 = unknown (cost estimates stay at zero).
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0

# Absolute path in production; the travel user must be able to write it.
DATABASE_URL=sqlite:///var/lib/travel-ai/app.db
PROMPTS_DIR=./src/prompts
DATA_DIR=./data
WEB_DIR=./src/frontend/dist

MAX_STEPS=8
MAX_REPAIRS=2
MAX_COMPLETION_TOKENS=4096
REQUEST_TIMEOUT_SECS=90
TOOL_TIMEOUT_SECS=8
MAX_QUERY_CHARS=1000
CONCURRENT_RUNS=4

# Identify the service to Nominatim/OSM; replace the contact address.
NOMINATIM_USER_AGENT=travel-ai-hackathon/0.1 (team@example.com)

# OpenRouteService secret (optional fallback for routing).
ORS_API_KEY=

# Demo and mock switches: 1 = enabled, 0 = disabled.
DEMO_MODE=0
MOCK_LLM=0
